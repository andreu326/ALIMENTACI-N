# Portón de entrada. Sin estas dos variables la app queda abierta.
# En Vercel: Project Settings → Environment Variables, y volver a desplegar.

# La contraseña con la que entras.
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Cualquier cadena larga y aleatoria.
# Genérala con:  openssl rand -base64 32
AUTH_SECRET=
